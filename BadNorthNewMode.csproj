<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>BadNorthNewMode</RootNamespace>
    <AssemblyName>BadNorthNewMode</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <!-- 不生成 [assembly: TargetFramework] 特性：该特性类型在游戏 mscorlib 2.0 里不存在，
         虽属无害（CLR 只在反射时才解析特性），但关掉能让 tools/check-api.ps1 的闸门完全干净。 -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Version>1.5.6</Version>
    <!-- 版本号与仓库提交版本(vX.Y.Z)保持一致：本工程 = 仓库版本，不再用独立的 0.2.x 内部编号。 -->
    <!-- 游戏目录优先级：命令行 -p:BadNorthDir=xxx > 环境变量 > 本默认值。所有引用一律以它为准，勿写绝对路径。 -->
    <BadNorthDir Condition="'$(BadNorthDir)' == ''">D:\Steam\steamapps\common\BadNorth</BadNorthDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(BadNorthDir)\BadNorth_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BadNorthDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(BadNorthDir)\BadNorth_Data\Managed\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(BadNorthDir)\BadNorth_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 仅用于 Physics.Raycast（点滩头陆地的地形射线） -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(BadNorthDir)\BadNorth_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 仅用于 Animator（下船看门狗的船动画状态诊断） -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(BadNorthDir)\BadNorth_Data\Managed\UnityEngine.AnimationModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 仅用于 UnityEngine.EventSystems.EventSystem（判断指针是否在 UI 上） -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(BadNorthDir)\BadNorth_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 仅用于 Canvas / RenderMode（v1.5.6 菜单点击拦截面 ClickShield 的覆盖层画布） -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(BadNorthDir)\BadNorth_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 仅用于 GUI.Label 的极简 HUD -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(BadNorthDir)\BadNorth_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
